apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  namespace: frases
  labels:
    app: backend
    tags.datadoghq.com/env: "dev"
    tags.datadoghq.com/service: "backend"
    tags.datadoghq.com/version: "1.5.0"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
        tags.datadoghq.com/env: "dev"
        tags.datadoghq.com/service: "backend"
        tags.datadoghq.com/version: "1.5.0"
        sidecar.istio.io/inject: "true"
        admission.datadoghq.com/enabled: "true"
        admission.datadoghq.com/config.mode: "socket"
      annotations:
        admission.datadoghq.com/python-lib.version: "latest"
        ad.datadoghq.com/backend.logs: '[{"source":"python","service":"backend"}]'
    spec:
      containers:
      - name: backend
        image: robarros/backend:v5
        ports:
        - containerPort: 8080
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8080
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /healthz
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 5
          failureThreshold: 3
        env:
        - name: DD_ENV
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['tags.datadoghq.com/env']
        - name: DD_SERVICE
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['tags.datadoghq.com/service']
        - name: DD_VERSION 
          valueFrom: 
            fieldRef: 
              fieldPath: metadata.labels['tags.datadoghq.com/version']
        - name: DD_DYNAMIC_INSTRUMENTATION_ENABLED
          value: "true"
        - name: DD_LOGS_INJECTION
          value: "true"
        - name: DD_TRACE_ENABLED
          value: "true"
        # - name: DD_TRACE_SAMPLE_RATE
        #   value: "1"
        - name: DD_TRACE_STARTUP_LOGS
          value: "true"
        - name: DD_PROFILING_ENABLED
          value: "true"
        - name: DD_RUNTIME_METRICS_ENABLED
          value: "true"
        - name: DD_APM_IGNORE_RESOURCES
          value: "GET /healthz/ready, GET /stats/prometheus"
        - name: DD_AGENT_HOST
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        - name: QUOTE_URL 
          value: "https://dummyjson.com/quotes/random"
        - name: VERSION
          valueFrom: 
            fieldRef: 
              fieldPath: metadata.labels['tags.datadoghq.com/version']


---
apiVersion: v1
kind: Service
metadata:
  name: svc-backend
  namespace: frases
spec:
  type: ClusterIP
  selector:
    app: backend
  ports:
  - protocol: TCP
    port: 8080
    targetPort: 8080

---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: backend-vs
  namespace: frases
spec:
  hosts:
  - svc-backend.frases.svc.cluster.local
  http:
  - match:
    - uri:
        prefix: /
    route:
    - destination:
        host: svc-backend.frases.svc.cluster.local
        port:
          number: 8080
    # fault:
    #   abort:
    #     httpStatus: 500
    #     percentage:
    #       value: 50
    #   delay:
    #     fixedDelay: 2s
    #     percentage:
    #       value: 50

---
apiVersion: networking.istio.io/v1beta1
kind: ServiceEntry
metadata:
  name: dummyjson-external
  namespace: frases
spec:
  hosts:
  - dummyjson.com
  ports:
  - number: 443
    name: https
    protocol: HTTPS
  location: MESH_EXTERNAL
  resolution: DNS
  # exportTo: # ["."] O serviço é visível apenas no namespace atual. exportTo: ["*"] - O serviço é visível em todos os namespaces
  # - "."

---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: dummyjson-vs
  namespace: frases
spec:
  hosts:
  - dummyjson.com
  http:
  - timeout: 30s  # Total request timeout
    retries:
      attempts: 3  # Retry up to 3 times
      perTryTimeout: 10s  # Timeout per attempt
      retryOn: "5xx,reset,connect-failure,retriable-4xx"
    route:
    - destination:
        host: dummyjson.com
        port:
          number: 443
