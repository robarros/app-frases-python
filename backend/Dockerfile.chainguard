# Stage 1: Builder
FROM cgr.dev/chainguard/python:3.12-dev as builder

WORKDIR /app

# Copiar requirements e instalar dependências
COPY requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime com Chainguard
FROM cgr.dev/chainguard/python:3.12

WORKDIR /app

# Copiar dependências instaladas pelo pip do stage builder
COPY --from=builder /home/nonroot/.local /home/nonroot/.local

# Copiar código da aplicação
COPY app.py ./

# Atualizar PATH para incluir binários instalados pelo pip
ENV PATH=/home/nonroot/.local/bin:$PATH
ENV PYTHONPATH=/home/nonroot/.local/lib/python3.12/site-packages

EXPOSE 8080

# Comando para iniciar a aplicação
# Chainguard roda como usuário nonroot por padrão
CMD ["-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
