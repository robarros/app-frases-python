# Stage 1: Builder
FROM python:3.11-slim as builder

WORKDIR /app

# Instalar dependências de build
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements e instalar dependências
COPY requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime com Distroless
FROM gcr.io/distroless/python3

WORKDIR /app

# Copiar dependências instaladas pelo pip do stage builder
COPY --from=builder /root/.local /root/.local

# Copiar código da aplicação
COPY app.py ./

# Atualizar PATH para incluir binários instalados pelo pip
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/root/.local/lib/python3.12/site-packages

EXPOSE 8080

# Comando para iniciar a aplicação
# Nota: Distroless usa o Python do sistema, então executamos diretamente
CMD ["-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
