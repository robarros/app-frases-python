apiVersion: v1
kind: ConfigMap
metadata:
  name: wiremock-mappings
  namespace: wiremock
  labels:
    app: wiremock
data:
  quotes-random.json: |
    {
      "request": {
        "method": "GET",
        "urlPath": "/quotes/random"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": 42,
          "quote": "A jornada de mil milhas começa com um único passo.",
          "author": "Lao Tzu"
        }
      }
    }

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wiremock
  namespace: wiremock
  labels:
    app: wiremock
spec:
  replicas: 1
  selector:
    matchLabels:
      app: wiremock
  template:
    metadata:
      labels:
        app: wiremock
        # sidecar.istio.io/inject: "true"
    spec:
      containers:
      - name: wiremock
        image: wiremock/wiremock:3.13.2
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 8080
          name: http
        volumeMounts:
        - name: wiremock-mappings
          mountPath: /home/wiremock/mappings
          readOnly: true
        livenessProbe:
          httpGet:
            path: /__admin/health
            port: 8080
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /__admin/health
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
      volumes:
      - name: wiremock-mappings
        configMap:
          name: wiremock-mappings

---
apiVersion: v1
kind: Service
metadata:
  name: wiremock
  namespace: wiremock
  labels:
    app: wiremock
spec:
  type: ClusterIP
  selector:
    app: wiremock
  ports:
  - port: 8080
    targetPort: 8080
    protocol: TCP
    name: http

---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: mock-virtualti-net-cert
  namespace: wiremock
spec:
  secretName: mock-virtualti-net-tls
  issuerRef:
    name: letsencrypt-prod
    kind: ClusterIssuer
  commonName: "mock.virtualti.net"
  dnsNames:
    - "mock.virtualti.net"
  privateKey:
    rotationPolicy: Never

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: mock-ingress
  namespace: wiremock
  annotations:
    kubernetes.io/ingress.class: "nginx"
    external-dns.alpha.kubernetes.io/hostname: mock.virtualti.net
    external-dns.alpha.kubernetes.io/target: 150.136.247.86
    # nginx.ingress.kubernetes.io/auth-tls-pass-certificate-to-upstream: "true"
    # nginx.ingress.kubernetes.io/auth-tls-secret: frases/ca-secret
    # nginx.ingress.kubernetes.io/auth-tls-verify-client: "on"
    # nginx.ingress.kubernetes.io/auth-tls-verify-depth: "1"
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - mock.virtualti.net
      secretName: mock-virtualti-net-tls
  rules:
    - host: mock.virtualti.net
      http:
        paths:
          - path: /quotes/random
            pathType: Prefix
            backend:
              service:
                name: wiremock
                port:
                  number: 8080